import os
from llama_index.core import VectorStoreIndex, SimpleDirectoryReader, StorageContext, load_index_from_storage
from llama_index.core.node_parser import SentenceSplitter
from llama_index.core.extractors import TitleExtractor, SummaryExtractor
from llama_index.core.ingestion import IngestionPipeline

# 1. DATA INGESTION & ROBUST PREPROCESSING
def build_v4c_knowledge_base(data_path="./v4c_docs"):
    # Load all PDFs/Docs from the folder
    documents = SimpleDirectoryReader(data_path).load_data()
    
    # Transformation Pipeline: This is the 'Enterprise' part
    pipeline = IngestionPipeline(
        transformations=[
            SentenceSplitter(chunk_size=512, chunk_overlap=50), # Smaller chunks = higher precision
            TitleExtractor(nodes=5), # Automatically tags the document title
            SummaryExtractor(summaries=["self"]) # Summarizes the context of each chunk
        ]
    )
    
    # Create nodes with metadata
    nodes = pipeline.run(documents=documents)
    
    # 2. PERSISTENT INDEXING (Avoid re-paying for embeddings)
    if not os.path.exists("./storage"):
        print("Creating new index...")
        index = VectorStoreIndex(nodes)
        index.storage_context.persist(persist_dir="./storage")
    else:
        print("Loading existing index...")
        storage_context = StorageContext.from_defaults(persist_dir="./storage")
        index = load_index_from_storage(storage_context)
    
    return index

# 3. ADVANCED RETRIEVAL (The Query Engine)
def query_v4c_expert(index, user_query):
    # 'Similarity_top_k=3' ensures the AI sees the 3 most relevant case studies
    query_engine = index.as_query_engine(similarity_top_k=3)
    response = query_engine.query(user_query)
    
    # In production, we always print the source to avoid hallucinations
    print(f"\n--- AI ANSWER ---\n{response}")
    print("\n--- SOURCES USED ---")
    for node in response.source_nodes:
        print(f"File: {node.metadata.get('file_name')} | Score: {node.score:.4f}")

